<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <!-- 需授权横幅（精确闹钟权限缺失时显示，点此去开启） -->
            <LinearLayout
                android:id="@+id/warn_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_danger"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠"
                    android:textSize="18sp"
                    android:layout_marginEnd="10dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="部分任务缺少“精确闹钟”权限，可能无法按时触发，点此去开启"
                    android:textSize="12sp"
                    android:textColor="#C0392B" />
            </LinearLayout>

            <!-- 休眠态横幅（无启用任务时显示） -->
            <LinearLayout
                android:id="@+id/dormant_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dormant"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌙"
                    android:textSize="24sp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="应用已休眠"
                        android:textStyle="bold"
                        android:textColor="@color/text_2" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="暂无启用中的任务，应用进程已退出，仅保留系统闹钟到点唤醒。"
                        android:textSize="12sp"
                        android:textColor="@color/text_3" />
                </LinearLayout>
            </LinearLayout>

            <!-- 空状态引导（零任务时显示） -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="48sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="还没有定时任务"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text"
                    android:layout_marginTop="12dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设定一个时间，到点自动打开指定应用并停留"
                    android:textSize="12sp"
                    android:textColor="@color/text_3"
                    android:layout_marginTop="4dp" />
                <TextView
                    android:id="@+id/empty_cta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="＋ 创建第一个任务"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@color/primary"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <!-- 概览卡（运行态显示） -->
            <LinearLayout
                android:id="@+id/overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_overview">

                <TextView
                    android:id="@+id/ov_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 项待执行"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/ov_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下次执行：—"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的任务"
                android:textSize="13sp"
                android:textColor="@color/text_3"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/task_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_card"
            android:src="@android:drawable/ic_media_previous" />
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="新建任务"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:gravity="center" />
        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保存"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 选择应用 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="选择应用" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_2" android:layout_marginBottom="8dp" />
            <LinearLayout
                android:id="@+id/pick_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/sel_app_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="请选择要打开的应用"
                    android:textColor="@color/text_3" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="18sp" android:textColor="@color/text_3" />
            </LinearLayout>

            <!-- 执行时间 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="执行时间" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_2" android:layout_marginBottom="8dp" />
            <TimePicker
                android:id="@+id/time_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:timePickerMode="spinner"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="16dp" />

            <!-- 停留时长 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="停留时长" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_2" android:layout_marginBottom="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/dur_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 分钟"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />
                <SeekBar
                    android:id="@+id/dur_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="59"
                    android:progress="0"
                    android:layout_marginTop="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <Button android:id="@+id/preset1" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1 分钟" android:layout_marginEnd="6dp" />
                    <Button android:id="@+id/preset5" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5 分钟" android:layout_marginEnd="6dp" />
                    <Button android:id="@+id/preset10" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10 分钟" android:layout_marginEnd="6dp" />
                    <Button android:id="@+id/preset30" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="30 分钟" />
                </LinearLayout>
            </LinearLayout>

            <!-- 重复规则 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="重复规则" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_2" android:layout_marginBottom="8dp" />
            <LinearLayout
                android:id="@+id/repeat_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:padding="4dp"
                android:layout_marginBottom="16dp">
                <TextView android:id="@+id/rep0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="每天" android:gravity="center" android:padding="9dp" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/rep1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="工作日" android:gravity="center" android:padding="9dp" android:textSize="13sp" />
                <TextView android:id="@+id/rep2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="周末" android:gravity="center" android:padding="9dp" android:textSize="13sp" />
                <TextView android:id="@+id/rep3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="仅一次" android:gravity="center" android:padding="9dp" android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_create"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="创建任务"
                android:backgroundTint="@color/primary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

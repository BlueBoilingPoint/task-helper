<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TaskHelper" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 底部导航标签：选中与未选中保持同一字号，避免选中时文字跳动 -->
    <style name="BottomNavText" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
